{
  "manifest_version": 3,
  "name": "Save to KAMI",
  "version": "1.1.1",
  "description": "Send the page you're reading to KAMI — captured in your browser, so paywalls you're signed into and bot walls don't get in the way.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Save to KAMI",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Save this page to KAMI"
    },
    "kami-peek": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Summarize this page with KAMI before saving"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://kami.sahilfruitwala.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "browser_specific_settings": {
    "gecko": { "id": "save-to-kami@sahilfruitwala.com", "strict_min_version": "121.0" }
  }
}
