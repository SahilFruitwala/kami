# Copy to `.env` and fill in values. Never commit `.env`.
#   cp .env.example .env
#   npm run db:up && npm run db:migrate

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local Docker (see docker-compose.yml):
DATABASE_URL=postgresql://quarto:quarto@127.0.0.1:5432/quarto

# Production (Neon, RDS, or any Postgres). Prefer SSL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# -----------------------------------------------------------------------------
# Auth (required when VITE_AUTH_ENABLED is not "false")
# -----------------------------------------------------------------------------
VITE_AUTH_ENABLED=true

# Long random secret (≥32 chars). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string

# Public origin of this app (no trailing slash). Local:
BETTER_AUTH_URL=http://localhost:8080
# Production:
# BETTER_AUTH_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Last-resort article extraction via xAI when Readability/Jina fail:
# XAI_API_KEY=

# Public hostname for share cards / OG (deploy only):
# VITE_PUBLIC_HOSTNAME=your-domain.com

# -----------------------------------------------------------------------------
# Grok App Builder platform only — leave unset for standalone deploys
# -----------------------------------------------------------------------------
# GROK_PROJECT_ID=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_GATE_ORIGIN=
