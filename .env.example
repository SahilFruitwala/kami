# Copy to `.env` and fill in values. Never commit `.env`.
#   cp .env.example .env
#   npm run db:up && npm run db:migrate

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local Docker (see docker-compose.yml):
DATABASE_URL=postgresql://quarto:quarto@127.0.0.1:5432/quarto

# Production (Neon, RDS, or any Postgres). Prefer SSL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# -----------------------------------------------------------------------------
# Auth — Clerk (required when VITE_AUTH_ENABLED is not "false")
# -----------------------------------------------------------------------------
VITE_AUTH_ENABLED=true

# From https://dashboard.clerk.com/ → your app → API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk hosts the prebuilt components (catch-all routes in src/routes/)
VITE_CLERK_SIGN_IN_URL=/login
VITE_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# Shelves — watchlist lookups
# -----------------------------------------------------------------------------
# TMDB read-only Bearer token (https://www.themoviedb.org/settings/api) for
# movie/TV search on /shelves. Without it, TMDB search returns no results;
# books (Open Library) and link previews need no key.
# TMDB_API_TOKEN=eyJ...

# -----------------------------------------------------------------------------
# Cache — Upstash Redis (optional, recommended in production)
# -----------------------------------------------------------------------------
# From https://console.upstash.com/ → your database → REST API. When set,
# hot Drizzle reads (shelf counts/lists/detail, journal, library snapshot)
# and third-party lookups (TMDB, Open Library, link previews, watch
# providers) are served from Redis with per-user keys + write invalidation.
# When unset, everything falls back to live queries (local dev behavior).
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=AX....
# Existing deployments may instead use these equivalent names:
# UPSTASH_URL=https://....upstash.io
# UPSTASH_TOKEN=AX....

# Build-time migrations: `pnpm build` migrates on Vercel Production builds
# (and non-Vercel builds) but skips Vercel Preview builds so unmerged branches
# never touch a shared database. Force on (e.g. previews with their own Neon
# branch) with 1, or disable everywhere with 0:
# MIGRATE_ON_BUILD=1

# Cap pg pool connections per serverless instance (default 5):
# DATABASE_POOL_MAX=5

# -----------------------------------------------------------------------------
# Feeds & newsletters (optional) — see docs/ARCHITECTURE.md
# -----------------------------------------------------------------------------
# Feeds are fetched on demand (Refresh on /feeds); nothing polls on a schedule.
# Optional: secret for the unscheduled sweep hook GET /api/hooks/feeds, if you
# later call it from a scheduler (`Authorization: Bearer …`, 16+ chars).
# CRON_SECRET=

# Private newsletter addresses (<token>@INBOUND_EMAIL_DOMAIN). Point the
# domain's inbound mail at /api/hooks/inbound-email (Postmark inbound, or a
# Cloudflare Email Worker) authenticated with INBOUND_EMAIL_SECRET (16+ chars).
# INBOUND_EMAIL_DOMAIN=in.your-domain.com
# INBOUND_EMAIL_SECRET=

# -----------------------------------------------------------------------------
# Extracts — Firecrawl (optional) — see docs/ARCHITECTURE.md
# -----------------------------------------------------------------------------
# From https://www.firecrawl.dev/app/api-keys. Powers /extracts ("ask a page a
# question"). Runs are on demand only and spend Firecrawl credits.
# FIRECRAWL_API_KEY=fc-...

# -----------------------------------------------------------------------------
# Library AI features (optional) — see docs/ARCHITECTURE.md#ai-features
# -----------------------------------------------------------------------------
# Summaries, auto-tag and organize, tidy, feed entry summaries, page peek and
# shelf suggestions. Set a key for at least one provider; without any key the
# AI buttons stay hidden and everything else works as normal.
# https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=...
# https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=sk-or-...
# Models are tried in order: the first one that answers wins, so a Google
# failure (or no Google key) falls back to Claude Haiku on OpenRouter.
# AI_MODELS=google:gemini-3.8-flash,openrouter:anthropic/claude-haiku-5.5

# -----------------------------------------------------------------------------
# Narration (optional) — see docs/ARCHITECTURE.md#narration
# -----------------------------------------------------------------------------
# "Create audio" in the reader narrates an article with Deepgram Aura-2 (via
# the AI SDK) and stores the MP3 in a private Cloudflare R2 bucket. Audio is
# only ever made when a reader asks, and spends their narration allowance
# (everyone starts at zero; grant with `pnpm narration:grant <email> <chars>`).
# Narration is off unless every variable below is set.
#
# Deepgram project API key with the `member` role:
# DEEPGRAM_API_KEY=...
# R2 bucket with public access OFF (no r2.dev URL, no custom domain; no CORS
# rule needed). Token: Object Read & Write, scoped to this bucket only.
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=kami-narrations
# Authenticates the background run's calls to itself (16+ chars):
#   openssl rand -hex 32
# NARRATION_RUN_SECRET=
# On Vercel, also generate Project → Deployment Protection → Protection Bypass
# for Automation; Vercel exposes it as VERCEL_AUTOMATION_BYPASS_SECRET.

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Public hostname for share cards / OG (deploy only):
# VITE_PUBLIC_HOSTNAME=your-domain.com
