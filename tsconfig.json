{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  // Trips and Research are parked (see vite.config.ts): their routes are out
  // of the route tree, so their files no longer type-check against it.
  "exclude": [
    "src/routes/trips",
    "src/routes/research",
    "src/routes/api/trips",
    "src/routes/api/research",
    "src/components/trips",
    "src/components/research"
  ]
}
